# ============ AgentCouncil 配置示例 ============
# 复制为 .env 后按需修改；所有配置项均有默认值，缺失或非法时回退默认（fail-open）

# 运行模式：false=真实数据（默认）；true=全 mock（冒烟测试固定 true）
MOCK_MODE=false

# 多空辩论最大轮数（≥1，conditional_edges + 计数防死循环）
DEBATE_MAX_ROUNDS=3

# 演示 fail-open：true 时行情工具故意失败（对应冒烟测试场景 3）
DEMO_TOOL_FAILURE=false

# ---------- 数据层（Milvus / bge / AkShare） ----------
# docker Milvus 本地库（容器名 milvus-standalone，端口 19530）
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=research_docs
# bge 嵌入模型（CLAUDE.md：bge-large-zh / bge-m3；首次运行自动下载权重）
BGE_MODEL=BAAI/bge-large-zh-v1.5
# HuggingFace 下载端点（国内网络建议 hf-mirror.com 镜像）
HF_ENDPOINT=https://hf-mirror.com
# 模型缓存目录（bge 权重约 1.3GB，建议放数据盘；不设置时默认用户主目录
# ~/.cache/agentcouncil/hf，跨平台可用）
HF_HOME=
# 行情历史回看窗口（自然日），用于 MA/RSI/MACD 计算
MARKET_HISTORY_DAYS=400
# 单次工具调用硬超时（秒）：超时即 fail-open 降级为 ToolResult(ok=False)，
# 防止阻塞式实现（Milvus RPC / 第三方 HTTP）把整条图卡死
TOOL_TIMEOUT_S=180
# 全链路墙钟预算（秒）：超时后不再发起新的 LLM/工具调用，控制最坏耗时
PIPELINE_DEADLINE_S=300

# ---------- 缓存（降低重复外部请求与 LLM 成本） ----------
# 行情/财务/新闻缓存 TTL（秒）；0 表示禁用
TOOL_CACHE_TTL_S=300
# 研报检索缓存 TTL（秒）；0 表示禁用
RAG_CACHE_TTL_S=3600
# LLM 结构化输出缓存 TTL（秒）；0 表示禁用
LLM_CACHE_TTL_S=3600

# ---------- 服务层安全（可选） ----------
# 非空时启用 Bearer 鉴权（客户端需带 Authorization: Bearer <token>）；留空为本地开放
API_TOKEN=
# 单 IP 每分钟请求上限；0 表示不限流
RATE_LIMIT_PER_MIN=0

# ---------- 风控规则（阈值可审计、可调；LLM 无权绕过） ----------
# 分析师无有效产出时一票否决（信息不可用时不输出投资结论）
RISK_VETO_ON_MISSING_DATA=true
# V2 技术面破位否决：空头排列 + MACD 柱为负 + RSI 低于该值
RISK_VETO_RSI_FLOOR=35
# 单日涨跌幅绝对值 ≥ 该值（%）时追加「极端波动」高风险项
RISK_EXTREME_MOVE_PCT=9.5
# V3 高波动否决：近 20 日年化波动率 ≥ 该值（%）且近 60 日最大回撤 ≥ 下一项（%）
RISK_VETO_ANNUAL_VOL_PCT=60
RISK_VETO_DRAWDOWN_PCT=25
# ATR14 占收盘价比例 ≥ 该值（%）时追加「ATR 放大」高风险项
RISK_ATR_SPIKE_PCT=5
# 量价背离：价格位于近 60 日区间该位置以上（0~1，越界自动钳制）
# 且量比低于下一项时判定缩量背离（量比阈值允许 >1，表示「低于略高于均量即缩量」）
RISK_DIVERGENCE_POSITION=0.8
RISK_DIVERGENCE_RATIO=0.8

# ---------- DeepSeek（Phase 2：LLM 已接入） ----------
# OpenAI 兼容客户端，base_url 可配置；未配置 key 时各 Agent 降级为
# 确定性模板 + 错误留痕（fail-open），不伪造 LLM 产出
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat